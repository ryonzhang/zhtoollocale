{
  "benchmark": "ZhToolLocale-hard-v0.1",
  "description": "Tier-2 HARD probes: nested wan/yi numerals, capital-form numerals, discount semantics (zhe), compound time idioms, harder surnames, structured addresses, non-leading recovery errors. DRAFT - native-speaker verification required for items marked VERIFY before any paper use.",
  "reference_date": "2026-06-05",
  "reference_weekday": "Friday",
  "layers": ["selection", "arguments", "result_use", "recovery"],
  "probes": [
    {"id": "h-nm-01", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "项目总预算是一亿两千三百万。",
     "tool": "set_budget(amount_cny: number)",
     "expected_args": {"amount_cny": 123000000},
     "note": "1yi(100M) + 2300wan(23M) = 123,000,000. Classic nesting trap (NOT 120,030,000)."},
    {"id": "h-nm-02", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "发票金额：壹万贰仟元整。",
     "tool": "set_invoice(amount_cny: number)",
     "expected_args": {"amount_cny": 12000},
     "note": "Capital-form (daxie) numerals used on invoices/cheques = 12000."},
    {"id": "h-nm-03", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "这批货三万五千六。",
     "tool": "create_quote(amount_cny: number)",
     "expected_args": {"amount_cny": 35600},
     "note": "Elliptical: 35600, NOT 35006."},
    {"id": "h-nm-04", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "库存还有两千零五十件。",
     "tool": "set_stock(quantity: integer)",
     "expected_args": {"quantity": 2050},
     "note": "ling = internal zero: 2050."},
    {"id": "h-un-01", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "称两斤半牛肉。",
     "tool": "order_produce(item: string, weight_kg: number)",
     "expected_args": {"item": "牛肉", "weight_kg": 1.25},
     "note": "2.5 jin = 1.25 kg. Fraction + jin combined."},
    {"id": "h-un-02", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "来半斤虾仁。",
     "tool": "order_produce(item: string, weight_kg: number)",
     "expected_args": {"item": "虾仁", "weight_kg": 0.25},
     "note": "0.5 jin = 0.25 kg."},
    {"id": "h-un-03", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "茶叶要三两。",
     "tool": "order_produce(item: string, weight_kg: number)",
     "expected_args": {"item": "茶叶", "weight_kg": 0.15},
     "note": "VERIFY: 1 liang = 50 g; 3 liang = 150 g = 0.15 kg."},
    {"id": "h-rd-01", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "下下周五交终稿。",
     "tool": "set_deadline(date: yyyy-mm-dd)",
     "expected_args": {"date": "2026-06-19"},
     "note": "Week of Jun 15-21 -> Friday Jun 19. Double-next trap."},
    {"id": "h-rd-02", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "两周后的今天复诊。",
     "tool": "book_appointment(date: yyyy-mm-dd)",
     "expected_args": {"date": "2026-06-19"},
     "note": "Today(Fri Jun 5) + 14 days = Fri Jun 19."},
    {"id": "h-tm-01", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "下午三点一刻开会。",
     "tool": "schedule_meeting(date: yyyy-mm-dd, time: HH:MM)",
     "expected_args": {"date": "2026-06-05", "time": "15:15"},
     "note": "yi ke = quarter hour = :15. Date defaults to today (no other day stated)."},
    {"id": "h-tm-02", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "明天凌晨一点系统维护。",
     "tool": "schedule_maintenance(date: yyyy-mm-dd, time: HH:MM)",
     "expected_args": {"date": "2026-06-06", "time": "01:00"},
     "note": "lingchen 1 = 01:00; 'tomorrow lingchen' = the night ahead, i.e. Jun 6 01:00."},
    {"id": "h-dc-01", "category": "currency", "layer": "arguments",
     "utterance_zh": "原价两百，打八折是多少就收多少。",
     "tool": "set_price(amount_cny: number)",
     "expected_args": {"amount_cny": 160},
     "note": "da ba zhe = pay 80% of price: 200 x 0.8 = 160. Discount-semantics trap (NOT 8% off, NOT 8 yuan off)."},
    {"id": "h-dc-02", "category": "currency", "layer": "arguments",
     "utterance_zh": "租金一千块，明年涨三成。",
     "tool": "set_next_year_rent(amount_cny: number)",
     "expected_args": {"amount_cny": 1300},
     "note": "san cheng = 30%: 1000 x 1.3 = 1300."},
    {"id": "h-pn-01", "category": "person_name", "layer": "arguments",
     "utterance_zh": "请把司马懿写进通讯录。",
     "tool": "add_contact(family_name: string, given_name: string)",
     "expected_args": {"family_name": "司马", "given_name": "懿"},
     "note": "Compound surname Sima + 1-char given name."},
    {"id": "h-pn-02", "category": "person_name", "layer": "arguments",
     "utterance_zh": "教练是张三丰。",
     "tool": "add_contact(family_name: string, given_name: string)",
     "expected_args": {"family_name": "张", "given_name": "三丰"},
     "note": "Single surname + 2-char given name; trap is mis-splitting at 张三."},
    {"id": "h-ad-01", "category": "address", "layer": "arguments",
     "utterance_zh": "收货地址：上海市浦东新区世纪大道100号3号楼502室。",
     "tool": "set_address(city: string, district: string, street: string, number: string digits only, building: string digits only, room: string digits only)",
     "expected_args": {"city": "上海市", "district": "浦东新区", "street": "世纪大道", "number": "100", "building": "3", "room": "502"},
     "note": "Deep hierarchy incl. building + room."},
    {"id": "h-fz-01", "category": "fuzzy_quantity", "layer": "arguments",
     "utterance_zh": "订一打半的玫瑰。",
     "tool": "order_produce(item: string, quantity: integer)",
     "expected_args": {"item": "玫瑰", "quantity": 18},
     "note": "1.5 dozen = 18."},
    {"id": "h-ld-01", "category": "lunar_date", "layer": "arguments",
     "utterance_zh": "明年春节（农历正月初一）回家，帮我订票。",
     "tool": "book_ticket(date: yyyy-mm-dd)",
     "expected_args": {"date": "2027-02-06"},
     "note": "VERIFY against authoritative calendar: Chinese New Year 2027 expected 2027-02-06."},
    {"id": "h-rec-01", "category": "numeral_wan_yi", "layer": "recovery",
     "utterance_zh": "转一万二。",
     "tool": "transfer(amount_cny: number)",
     "simulated_first_call": {"amount_cny": 10002},
     "tool_error": "ValidationError: amount appears incorrect. Re-read the user's request and resubmit.",
     "expected_recovery_args": {"amount_cny": 12000},
     "note": "NON-LEADING error (no hint) - tests true self-correction, unlike tier-1 recovery."},
    {"id": "h-rec-02", "category": "currency", "layer": "recovery",
     "utterance_zh": "原价五百，打七五折收款。",
     "tool": "charge(amount_cny: number)",
     "simulated_first_call": {"amount_cny": 425},
     "tool_error": "ValidationError: amount appears incorrect. Re-read the user's request and resubmit.",
     "expected_recovery_args": {"amount_cny": 375},
     "note": "qi-wu zhe = 75% of price: 500 x 0.75 = 375 (first call wrongly did 15% off). Non-leading error."}
  ]
}
