{
  "benchmark": "ZhToolLocale-v0.2",
  "description": "Chinese-locale tool-call conversion-correctness probes. Tests whether models correctly convert Chinese locale semantics (dates, numerals, units, names, addresses) into canonical tool arguments. Complementary to MLCL (arXiv:2601.05366): MLCL measures value-language-mismatch; this measures conversion correctness + autonomous recovery. v0.2: reference date is now injected into prompts (v0.1 task-validity fix); ad-01 spec tightened.",
  "reference_date": "2026-06-05",
  "reference_weekday": "Friday",
  "layers": ["selection", "arguments", "result_use", "recovery"],
  "categories": ["relative_date", "lunar_date", "numeral_wan_yi", "currency", "unit_conversion", "person_name", "address", "phone", "classifier", "code_switch", "fullwidth", "fuzzy_quantity"],
  "probes": [
    {"id": "rd-01", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "帮我把会议安排在大后天上午十点。",
     "tool": "schedule_meeting(date: ISO-8601 yyyy-mm-dd, time: HH:MM)",
     "expected_args": {"date": "2026-06-08", "time": "10:00"},
     "note": "大后天 = +3 days from 2026-06-05."},
    {"id": "rd-02", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "下周三下午三点提醒我交报告。",
     "tool": "set_reminder(date: yyyy-mm-dd, time: HH:MM)",
     "expected_args": {"date": "2026-06-10", "time": "15:00"},
     "note": "this week = Jun 1-7; next Wednesday = Jun 10."},
    {"id": "rd-03", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "把订单截止日设成这个月月底。",
     "tool": "set_deadline(date: yyyy-mm-dd)",
     "expected_args": {"date": "2026-06-30"},
     "note": "month-end = last day of current month."},
    {"id": "rd-04", "category": "relative_date", "layer": "arguments",
     "utterance_zh": "下个月初安排一次体检。",
     "tool": "book_appointment(date: yyyy-mm-dd)",
     "expected_args": {"date": "2026-07-01"},
     "note": "early next month ~ first day of next month."},
    {"id": "ld-01", "category": "lunar_date", "layer": "arguments",
     "utterance_zh": "中秋节那天（农历八月十五）订一桌饭。",
     "tool": "reserve_table(date: yyyy-mm-dd)",
     "expected_args": {"date": "2026-09-25"},
     "note": "VERIFY against an authoritative lunar calendar; Mid-Autumn 2026 = 2026-09-25. Known-hard probe. NB: in the v0.1 run (no reference date) Gemini answered 2024-09-17, which IS Mid-Autumn 2024 - lunar knowledge present, year-anchoring was our bug."},
    {"id": "nm-01", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "转账一万二到我的储蓄账户。",
     "tool": "transfer(amount_cny: number)",
     "expected_args": {"amount_cny": 12000},
     "note": "12000, NOT 10002. High-stakes (finance)."},
    {"id": "nm-02", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "这套设备报价两百五十万。",
     "tool": "create_quote(amount_cny: number)",
     "expected_args": {"amount_cny": 2500000},
     "note": "2,500,000."},
    {"id": "nm-03", "category": "numeral_wan_yi", "layer": "arguments",
     "utterance_zh": "充值三千五就够了。",
     "tool": "recharge(amount_cny: number)",
     "expected_args": {"amount_cny": 3500},
     "note": "3500, NOT 3005."},
    {"id": "cur-01", "category": "currency", "layer": "arguments",
     "utterance_zh": "这杯咖啡三块五。",
     "tool": "add_item(price_cny: number)",
     "expected_args": {"price_cny": 3.5},
     "note": "kuai = yuan; 3.5 CNY."},
    {"id": "cur-02", "category": "currency", "layer": "arguments",
     "utterance_zh": "预算是五十万人民币。",
     "tool": "set_budget(amount_cny: number)",
     "expected_args": {"amount_cny": 500000},
     "note": "500000."},
    {"id": "un-01", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "买两斤苹果。",
     "tool": "order_produce(item: string, weight_kg: number)",
     "expected_args": {"item": "苹果", "weight_kg": 1.0},
     "note": "1 jin = 0.5 kg; 2 jin = 1.0 kg."},
    {"id": "un-02", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "我身高一米八。",
     "tool": "set_profile(height_m: number)",
     "expected_args": {"height_m": 1.8},
     "note": "1.8 m."},
    {"id": "un-03", "category": "unit_conversion", "layer": "arguments",
     "utterance_zh": "目的地大概三公里外。",
     "tool": "set_destination(distance_m: number)",
     "expected_args": {"distance_m": 3000},
     "note": "3 km = 3000 m."},
    {"id": "pn-01", "category": "person_name", "layer": "arguments",
     "utterance_zh": "联系人是张伟。",
     "tool": "add_contact(family_name: string, given_name: string)",
     "expected_args": {"family_name": "张", "given_name": "伟"},
     "note": "Family name first."},
    {"id": "pn-02", "category": "person_name", "layer": "arguments",
     "utterance_zh": "把欧阳娜娜加到嘉宾名单。",
     "tool": "add_guest(family_name: string, given_name: string)",
     "expected_args": {"family_name": "欧阳", "given_name": "娜娜"},
     "note": "Compound surname."},
    {"id": "ad-01", "category": "address", "layer": "arguments",
     "utterance_zh": "寄到北京市海淀区中关村大街1号。",
     "tool": "set_address(city: string, district: string, street: string, number: string with digits only, no 号 suffix)",
     "expected_args": {"city": "北京市", "district": "海淀区", "street": "中关村大街", "number": "1"},
     "note": "v0.2: spec now explicitly requires digits-only number, making the gold defensible."},
    {"id": "ph-01", "category": "phone", "layer": "arguments",
     "utterance_zh": "我的手机号是一三八零零一三八零零零。",
     "tool": "set_phone(number: string, 11 digits no separators)",
     "expected_args": {"number": "13800138000"},
     "note": "Spoken digits to canonical string."},
    {"id": "cl-01", "category": "classifier", "layer": "arguments",
     "utterance_zh": "来三杯美式咖啡。",
     "tool": "order_drink(item: string, quantity: integer)",
     "expected_args": {"item": "美式咖啡", "quantity": 3},
     "note": "Classifier excluded from item."},
    {"id": "cs-01", "category": "code_switch", "layer": "arguments",
     "utterance_zh": "订明天下午3点去上海的高铁票。",
     "tool": "book_train(date: yyyy-mm-dd, time: HH:MM, destination: string)",
     "expected_args": {"date": "2026-06-06", "time": "15:00", "destination": "上海"},
     "note": "Mixed Chinese + Arabic numeral; tomorrow = 2026-06-06."},
    {"id": "fw-01", "category": "fullwidth", "layer": "arguments",
     "utterance_zh": "金额：１２３４元。",
     "tool": "set_amount(amount_cny: number)",
     "expected_args": {"amount_cny": 1234},
     "note": "Full-width digits normalize to 1234."},
    {"id": "fq-01", "category": "fuzzy_quantity", "layer": "arguments",
     "utterance_zh": "给我来半打鸡蛋。",
     "tool": "order_produce(item: string, quantity: integer)",
     "expected_args": {"item": "鸡蛋", "quantity": 6},
     "note": "Half a dozen = 6."},
    {"id": "rec-01", "category": "unit_conversion", "layer": "recovery",
     "utterance_zh": "买两斤香蕉。",
     "tool": "order_produce(item: string, weight_kg: number)",
     "simulated_first_call": {"item": "香蕉", "weight_kg": 2},
     "tool_error": "ValidationError: weight_kg looks too large; note 1 jin = 0.5 kg. Please resubmit.",
     "expected_recovery_args": {"item": "香蕉", "weight_kg": 1.0},
     "note": "Recovery: correct 2 jin -> 1.0 kg after error."},
    {"id": "rec-02", "category": "numeral_wan_yi", "layer": "recovery",
     "utterance_zh": "转一万二。",
     "tool": "transfer(amount_cny: number)",
     "simulated_first_call": {"amount_cny": 10002},
     "tool_error": "ConfirmError: amount 10002 - please confirm the spoken amount.",
     "expected_recovery_args": {"amount_cny": 12000},
     "note": "Recovery: correct 10002 -> 12000 after challenge."}
  ]
}
